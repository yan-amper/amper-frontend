# --- Публичные (попадают в браузерный бандл) ---
NEXT_PUBLIC_API_URL=          # Backend base URL (HTTPS)
NEXT_PUBLIC_PHONE_NUMBER=     # Shop phone (digits only, e.g. 79001234567)
NEXT_PUBLIC_YANDEX_ID=        # Yandex.Metrika counter id

# --- Серверные (в браузер НЕ попадают, префикса NEXT_PUBLIC_ быть не должно) ---
SUPABASE_URL=
SUPABASE_KEY=

# Учётка админки на /admin. Пароль длинный и случайный:
# форма логина — публичный адрес, её можно перебирать.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# --- Боты ---
TG_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_SUPABASE_URL=
MAX_SUPABASE_KEY=
MAX_ADMIN_IDS=                # Comma-separated admin IDs
